class Solution {
public:
    bool isPalindrome(int x) {
        long long z = 0, y = 0;
        long long x2 = x;
        long long x3=x;
        if(x<0){
            x3=-x3;
        }
        for (int i = 0; x2 != 0; i++) {
            z = x2 % 10;
            y = y * 10 + z;
            x2 = x2 / 10;
        }
        if (x3 == y) {
            return true;
        } else {
            return false;
        }
    }
};
